{% extends "layouts/base.html" %}
{% comment %} {% extends 'layouts/base.html' %}
{% block title %} Edit Property {% endblock title %}
{% block content %}
<div class="container">
  <h3>Edit Property</h3>
  {% if errors %}
    <div class="alert alert-danger">
      {{ errors }}
    </div>
  {% endif %}
  <form id="editForm" method="POST" action="/rental-properties/{{ property.id }}/edit/">
    {% csrf_token %}
    <div class="mb-3">
      <label class="form-label">Property Id</label>
      <input type="text" class="form-control" name="id" value="{{ property.id }}" readonly>
    </div>
    <div class="mb-3">
      <label class="form-label">Reference Number</label>
      <input type="text" class="form-control" name="reference_number" value="{{ property.reference_number }}">
    </div>
    <div class="mb-3">
      <label class="form-label">Deal Date</label>
      <input type="date" class="form-control" name="deal_date" value="{{ property.deal_date|date:'Y-m-d' }}">
    </div>
    <div class="mb-3">
      <label class="form-label">Unit No</label>
      <input type="text" class="form-control" name="unit_details" value="{{ property.unit_details }}">
    </div>
    <div class="mb-3">
      <label class="form-label">Building Name</label>
      <input type="text" class="form-control" name="building_name" value="{{ property.building_name }}">
    </div>
    <div class="mb-3">
      <label class="form-label">Project Name</label>
      <input type="text" class="form-control" name="project_name" value="{{ property.project_name }}">
    </div>
    <div class="mb-3">
      <label class="form-label">PMS Price</label>
      <input type="number" step="0.01" class="form-control" name="pms_price" value="{{ property.pms_price }}">
    </div>
    <div class="mb-3">
      <label class="form-label">PM Start Date</label>
      <input type="date" class="form-control" name="pm_start_date" value="{{ property.pm_start_date|date:'Y-m-d' }}">
    </div>
    <div class="mb-3">
      <label class="form-label">PM End Date</label>
      <input type="date" class="form-control" name="pm_end_date" value="{{ property.pm_end_date|date:'Y-m-d' }}">
    </div>
    <div class="mb-3">
      <label class="form-label">Tenancy Start Date</label>
      <input type="date" class="form-control" name="tenancy_start_date" value="{{ property.tenancy_start_date|date:'Y-m-d' }}">
    </div>
    <div class="mb-3">
      <label class="form-label">Tenancy End Date</label>
      <input type="date" class="form-control" name="tenancy_end_date" value="{{ property.tenancy_end_date|date:'Y-m-d' }}">
    </div>
    <div class="mb-3">
      <label class="form-label">Submitted Date</label>
      <input type="date" class="form-control" name="submitted_date" value="{{ property.submitted_date|date:'Y-m-d' }}" readonly>
    </div>
    <div class="mb-3">
      <label class="form-label">Status</label>
      <input type="text" class="form-control" name="status" value="{{ property.status }}" readonly>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/rental-properties/all/" class="btn btn-secondary">Cancel</a>
  </form>
</div>
{% endblock %} {% endcomment %}



