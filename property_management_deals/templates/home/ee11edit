{% comment %} $j(document).ready(function() {
    const propertyId = {{ property.id }};
    const apiUrl = `/api/rental-properties/${propertyId}/`;

    // Format date to yyyy-mm-dd
    function formatDateForInput(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toISOString().split('T')[0];
    }

    

    // Load data into form
    function loadPropertyData() {
        $j.ajax({
            url: apiUrl,
            type: 'GET',
            success: function(data) {
                loadAgentDropdown(data);

                // Fill standard fields
                Object.keys(data).forEach(key => {
                    const field = $j(`[name="${key}"]`);
                    console.log(`Filling field: name="${key}" with value:`, data[key]);
                    if (field.length) {
                        if (field.is('input[type="date"]')) {
                            field.val(formatDateForInput(data[key]));
                        } else if (field.is('select')) {
                            field.val(data[key]);
                        } else if (field.is('textarea')) {
                            field.text(data[key]);
                        } else {
                            field.val(data[key]);
                        }
                    }
                });

                // Dynamically handle cheque_date array
                if (data.cheque_date && Array.isArray(data.cheque_date)) {
                    $j('.append-cheque-date').empty(); // Clear previous rows
                    data.cheque_date.forEach((dateStr, index) => {
                        const rowHtml = `
                            <div class="row delete-cheque-date-row${index}">
                                <div class="col-md-6 form-group">
                                    <label>Cheque Date <span class="mandetory_field" style="color:red">*</span></label>
                                    <input type="text" name="cheque_date[${index}]" class="form-control cheque-dates previous-cheque-date" id="cheque_dates_${index}" value="${dateStr}" readonly style="background-color:white;">
                                    <span class="error text-danger" id="cheque_date_error_${index}"></span>
                                </div>
                                <div class="col-md-2 form-group" style="top:20px;">
                                    <a class="txt-color btn btn-primary btn-rounded m-1 remove-cheque-date-row" style="float: right; color: white; margin-left: 5px;">Remove</a>  
                                </div>
                            </div>`;
                        $j('.append-cheque-date').append(rowHtml);

                        // ✅ Initialize Datepicker
                        $j(`#cheque_dates_${index}`).datepicker({
                            dateFormat: 'dd-mm-yy'
                        });
                    });

                    // Update no_of_cheque field based on count
                    $j('#no_of_cheque').val(data.cheque_date.length);
                }

                // File fields
                const fileFields = [
                    'pms_contract', 'owner_passport_copy', 'owner_eid_copy',
                    'pms_cheque_copy', 'title_deed', 'poa_pp',
                    'poa_copy', 'key_hand_over_form', 'kyc_form', 'screening'
                ];

                fileFields.forEach(field => {
                    if (data[field]) {
                        $j(`#${field}_link`).attr('href', data[`${field}_link`]).text(data[field]);
                    }
                });

                // Special select fields
                $j('#approve_reject').val(data.approve_reject || 'Approve');
                $j('#aml').val(data.aml || 'Yes');
                $j('#is_entered_in_finance').val(data.is_entered_in_finance || 'No');
            },
            error: function(error) {
                console.error('Error loading property data:', error);
                alert('Failed to load property data. Please refresh the page.');
            }
        });
    }


    // Submit form via AJAX
    $j('#editPropertyForm').on('submit', function(e) {
        e.preventDefault();

        const formData = new FormData(this);
        const submitBtn = $j(this).find('button[type="submit"]');

        submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...');

        $j.ajax({
            url: apiUrl,
            type: 'PUT',
            data: formData,
            processData: false,
            contentType: false,
            headers: {
                'X-CSRFToken': $main('[name=csrfmiddlewaretoken]').val()
            },
            success: function(data) {
                alert('Property updated successfully!');
                window.location.href = "{% url 'rental-property-list' %}";
            },
            error: function(error) {
                console.error('Error updating property:', error);
                let errorMsg = 'Error updating property.';
                if (error.responseJSON) {
                    errorMsg += '\n' + JSON.stringify(error.responseJSON, null, 2);
                }
                alert(errorMsg);
            },
            complete: function() {
                submitBtn.prop('disabled', false).text('Save Changes');
            }
        });
    });

    // Load initial data
    loadPropertyData();

    // Warn on unsaved changes
    let formChanged = false;
    $j('#editPropertyForm').on('change input', 'input, select, textarea', function() {
        formChanged = true;
    });

    window.addEventListener('beforeunload', function(e) {
        if (formChanged) {
            e.preventDefault();
            e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
        }
    });

    // Confirm cancel
    $j('a.btn-secondary').on('click', function(e) {
        if (formChanged) {
            if (!confirm('You have unsaved changes. Are you sure you want to leave?')) {
                e.preventDefault();
            }
        }
    });
});

function loadAgentDropdown(requestdata) {
  $.ajax({
    url: "/api/agents/dropdown/",
    type: "GET",
    success: function (agents) {
      populateAgentDropdown(
        "#submitted_by_agent",
        agents,
        requestdata.submitted_by_agent
      );
      populateAgentDropdown("#agent_name1", agents, requestdata.agent_name1);
      populateAgentDropdown("#agent_name2", agents, requestdata.agent_name2);
      populateAgentDropdown("#agent_name3", agents, requestdata.agent_name3);
    },
    error: function () {
      console.error("Failed to load agents.");
    },
  });
}

// populate the user data based on requriement

function populateAgentDropdown(selector, data, selectedId = null) {
  const $dropdown = $(selector);
  $dropdown.empty().append('<option value="">Select Agent</option>');

  data.forEach(function (agent) {
    const isSelected = selectedId == agent.id ? "selected" : "";
    $dropdown.append(
      `<option value="${agent.id}" ${isSelected}>${agent.name}</option>`
    );
  });
} {% endcomment %}

$j(document).ready(function() {
    const propertyId = {{ property.id }};
