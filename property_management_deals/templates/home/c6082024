{% extends 'layouts/base.html' %}
{% block title %} Create Property {% endblock title %}

{% block stylesheets %}
<style>
    a.addition {
        position: relative;
        margin-left: 10px;
        top: 0;
    }
    a.subtraction {
        position: relative;
        margin-left: 10px;
        top: 0;
    }
    .cheque-dates {
        margin-right: 20px;
    }
    .form-group {
        margin-bottom: 1.5rem;
    }
    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
    .nav-tabs .nav-link {
        border-radius: 0.25rem;
        margin-right: 5px;
    }
    .nav-tabs .nav-link.active {
        background-color: #007bff;
        color: white;
    }
    .btn-rounded {
        border-radius: 50px;
    }
    .file-preview {
        margin-top: 10px;
        font-size: 0.875rem;
    }
</style>
{% endblock stylesheets %}

{% block content %}
<div class="main-content pt-4">
    <div class="row">
        <div class="col-md-12" id="successmsg" style="display: none">
            <div class="alert alert-primary" id="alert-primary">
                <button class="close float-right" type="button" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
        </div>
        <div class="col-md-12">
            <div class="card mt-3 mb-3">
                <div class="card-header bg-transparent">
                    <h4 class="pb-2">Create Property
                        <span class="float-right">
                            <a class="btn btn-primary btn-rounded" href="#" onclick="window.history.back();">Cancel</a>
                        </span>
                    </h4>
                </div>
                <div class="card-body m-1">
                    <nav>
                        <div class="nav nav-tabs" id="nav-tab" role="tablist">
                            <a href="#nav-property" class="nav-item nav-link active show" id="nav-property-tab" data-toggle="tab" role="tab" aria-controls="nav-property" aria-selected="true">Property Details</a>
                            <a href="#nav-source" class="nav-item nav-link" id="nav-source-tab" data-toggle="tab" role="tab" aria-controls="nav-source" aria-selected="false">Owner Details</a>
                            <a href="#nav-agency" class="nav-item nav-link" id="nav-agency-tab" data-toggle="tab" role="tab" aria-controls="nav-agency" aria-selected="false">Owner Agency Details</a>
                            <a href="#nav-cheque" class="nav-item nav-link" id="nav-cheque-tab" data-toggle="tab" role="tab" aria-controls="nav-cheque" aria-selected="false">Cheque Details</a>
                            <a href="#nav-revenue" class="nav-item nav-link" id="nav-revenue-tab" data-toggle="tab" role="tab" aria-controls="nav-revenue" aria-selected="false">Revenue Details</a>
                            <a href="#nav-documents" class="nav-item nav-link" id="nav-documents-tab" data-toggle="tab" role="tab" aria-controls="nav-documents" aria-selected="false">Upload Documents</a>
                        </div>
                    </nav>
                    <form id="rental_property_form"   enctype="multipart/form-data" novalidate="novalidate">
                         
                        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                        <input type="hidden" value="2" name="account_id" id="account_id">
                        <div class="tab-content ul-tab__content" id="nav-tabContent">
                            <!-- Property Details -->
                            <div class="tab-pane fade active show" id="nav-property" role="tabpanel" aria-labelledby="nav-property-tab">
                                <div class="form-group row nav-property">
                                    {% if perms.property_management_deals.admin_properties_fields_rentalproperties %}
                                        <div class="col-md-6 form-group">
                                            <label for="submitted_by_agent">Deal Submitted By Agent<span class="mandetory_field" style="color: red">*</span></label>
                                            <select class="selectbox2 form-control" name="submitted_by_agent" id="submitted_by_agent" required>
                                                <option value="">Select Agent Name</option>
                                                {% for agent in agents %}
                                                <option value="{{ agent.id }}">{{ agent.name }}</option>
                                                {% endfor %}
                                            </select>
                                            <span class="text-danger" id="submitted_by_agent_error"></span>
                                        </div>
                                    {% endif %}
                                    <div class="col-md-6 form-group">
                                        <label for="deal_date">Deal Date<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="date" id="deal_date" name="deal_date" class="form-control" required>
                                        <span class="text-danger" id="deal_date_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="reference_number">Reference Number<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="reference_number" class="form-control" id="reference_number" placeholder="Reference No" required>
                                        <span class="text-danger" id="reference_number_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="project_name">Project Name<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="project_name" class="form-control" id="project_name" placeholder="Project Name" required>
                                        <span class="text-danger" id="project_name_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="building_name">Building Name<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="building_name" class="form-control" id="building_name" placeholder="Building Name" required>
                                        <span class="text-danger" id="building_name_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="unit_details">Unit No<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="unit_details" class="form-control" id="unit_details" placeholder="Unit No" required>
                                        <span class="text-danger" id="unit_details_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="pms_price">PMS Price<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="pms_price" class="form-control" id="pms_price" placeholder="PMS Price" required>
                                        <span class="text-danger" id="pms_price_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="pm_start_date">PM Start Date<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="date" name="pm_start_date" class="form-control startDate" id="pm_start_date" required>
                                        <span class="text-danger" id="pm_start_date_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="pm_end_date">PM End Date<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="date" name="pm_end_date" class="form-control endDate" id="pm_end_date" required>
                                        <span class="text-danger" id="pm_end_date_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="tenancy_start_date">Tenancy Start Date<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="date" name="tenancy_start_date" class="form-control startDates" id="tenancy_start_date" required>
                                        <span class="text-danger" id="tenancy_start_date_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="tenancy_end_date">Tenancy End Date<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="date" name="tenancy_end_date" class="form-control endDates" id="tenancy_end_date" required>
                                        <span class="text-danger" id="tenancy_end_date_error"></span>
                                    </div>
                                </div>
                                <hr>
                                <div class="form-group row mt-3">
                                    <div class="col-sm-12 d-flex justify-content-center">
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-source')">Next</button>
                                        {% if perms.property_management_deals.create_draft_property_rentalproperties %}
                                            <button type="button" class="btn btn-primary btn-rounded m-1" id="saveAsDraftProperty" onclick="saveAsDraft()">Save As Draft</button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <!-- Owner Details -->
                            <div class="tab-pane fade" id="nav-source" role="tabpanel" aria-labelledby="nav-source-tab">
                                <div class="form-group row nav-source">
                                    <div class="col-md-6 form-group">
                                        <label for="owner_first_name">Name<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="owner_first_name" class="form-control" id="owner_first_name" placeholder="Owner Name" required>
                                        <span class="text-danger" id="owner_first_name_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="owner_source">Source<span class="mandetory_field" style="color: red">*</span></label>
                                        <select class="selectbox2 form-control" name="owner_source" id="owner_source" required>
                                            <option value="">Select Owner Source</option>
                                            <option value="Dubizzle">Dubizzle</option>
                                        </select>
                                        <span class="text-danger" id="owner_source_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="owner_mobile">Mobile<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" id="owner_mobile" name="owner_mobile" class="form-control" placeholder="Owner Mobile" required>
                                        <span class="text-danger" id="owner_mobile_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="owner_email">Email<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="email" id="owner_email" name="owner_email" class="form-control" placeholder="Owner Email" required>
                                        <span class="text-danger" id="owner_email_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="seller_nationality">Nationality<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" id="seller_nationality" name="seller_nationality" class="form-control" placeholder="Seller Nationality" required>
                                        <span class="text-danger" id="seller_nationality_error"></span>
                                    </div>
                                </div>
                                <hr>
                                <div class="form-group row mt-3">
                                    <div class="col-sm-12 d-flex justify-content-center">
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-property')">Previous</button>
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-agency')">Next</button>
                                        {% if perms.property_management_deals.create_draft_property_rentalproperties %}
                                           <button type="button" class="btn btn-primary btn-rounded m-1" id="saveAsDraftSource" onclick="saveAsDraft()">Save As Draft</button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <!-- Owner Agency Details -->
                            <div class="tab-pane fade" id="nav-agency" role="tabpanel" aria-labelledby="nav-agency-tab">
                                <div class="form-group row nav-agency">
                                    <div class="col-md-6 form-group">
                                        <label for="agency_name">Agency Name<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="agency_name" class="form-control" id="agency_name" placeholder="Agency Name" required>
                                        <span class="text-danger" id="agency_name_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent_name">Agent Name<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="agent_name" class="form-control" id="agent_name" placeholder="Agent Name" required>
                                        <span class="text-danger" id="agent_name_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="brn">Agent BRN</label>
                                        <input type="text" id="brn" name="brn" class="form-control" placeholder="Agent BRN">
                                        <span class="text-danger" id="brn_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent_phone">Agent Phone<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" id="agent_phone" name="agent_phone" class="form-control" placeholder="Agent Phone" required>
                                        <span class="text-danger" id="agent_phone_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent_email">Agent Email</label>
                                        <input type="email" id="agent_email" name="agent_email" class="form-control" placeholder="Agent Email">
                                        <span class="text-danger" id="agent_email_error"></span>
                                    </div>
                                </div>
                                <hr>
                                <div class="form-group row mt-3">
                                    <div class="col-sm-12 d-flex justify-content-center">
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-source')">Previous</button>
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-cheque')">Next</button>
                                        {% if perms.property_management_deals.create_draft_property_rentalproperties %}
                                            <button type="button" class="btn btn-primary btn-rounded m-1" id="saveAsDraftAgency" onclick="saveAsDraft()">Save As Draft</button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <!-- Cheque Details -->
                            <div class="tab-pane fade" id="nav-cheque" role="tabpanel" aria-labelledby="nav-cheque-tab">
                                <div class="row form-group nav-cheque">
                                    <div class="col-md-5 form-group">
                                        <label for="no_of_cheque">Number Of Cheques<span class="mandetory_field" style="color: red">*</span> (Max-12)</label>
                                        <input type="text" id="no_of_cheque" name="no_of_cheque" class="form-control" placeholder="Number Of Cheques" required>
                                        <span class="text-danger" id="no_of_cheque_error"></span>
                                    </div>
                                </div>
                                <div class="row form-group nav-cheque cheque-date">
                                    <div class="col-md-5 form-group">
                                        <label for="cheque_date_1">Cheque Date<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="date" id="cheque_date_1" name="cheque_date[]" class="form-control cheque-dates" placeholder="Cheque Date" required>
                                        <span class="text-danger" id="cheque_date_1_error"></span>
                                    </div>
                                    <div class="col-md-7 form-group">
                                        <button type="button" class="btn btn-primary btn-rounded m-1 addition" id="add-cheque-row">Add</button>
                                    </div>
                                </div>
                                <div class="row form-group nav-cheque append-cheque-date"></div>
                                <br>
                                <small>(Note: The date of cheques may vary, so add additional rows as needed, up to a maximum of 12.)</small>
                                <hr>
                                <div class="form-group row mt-3">
                                    <div class="col-sm-12 d-flex justify-content-center">
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-agency')">Previous</button>
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-revenue')">Next</button>
                                        {% if perms.property_management_deals.create_draft_property_rentalproperties %}
                                           <button type="button" class="btn btn-primary btn-rounded m-1" id="saveAsDraftCheque" onclick="saveAsDraft()">Save As Draft</button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <!-- Revenue Details -->
                            <div class="tab-pane fade" id="nav-revenue" role="tabpanel" aria-labelledby="nav-revenue-tab">
                                <div class="row form-group nav-revenue">
                                    <div class="col-md-6 form-group">
                                        <label for="total_commission">Total Commission<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="total_commission" class="form-control" id="total_commission" placeholder="Total Commission" required>
                                        <span class="text-danger" id="total_commission_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="less_outside_commission">Less Outside Commission<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="less_outside_commission" class="form-control" id="less_outside_commission" placeholder="Less Outside Commission" required>
                                        <span class="text-danger" id="less_outside_commission_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="net_commission">Net Commission<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" name="net_commission" class="form-control" id="net_commission" placeholder="Net Commission" required>
                                        <span class="text-danger" id="net_commission_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="classic">Classic<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" id="classic" name="classic" class="form-control" placeholder="Classic" required>
                                        <span class="text-danger" id="classic_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent1">Agent 1 Commission<span class="mandetory_field" style="color: red">*</span></label>
                                        <input type="text" id="agent1" name="agent1" class="form-control" placeholder="Agent Commission" required>
                                        <span class="text-danger" id="agent1_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent_name1">Agent Name<span class="mandetory_field" style="color: red">*</span></label>
                                        <select name="agent_name1" class="form-control" id="agent_name1" required>
                                            <option value="">Select Agent</option>
                                            {% for agent in agents %}
                                            <option value="{{ agent.id }}">{{ agent.name }}</option>
                                            {% endfor %}
                                        </select>
                                        <span class="text-danger" id="agent_name1_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent2">Agent 2 Commission</label>
                                        <input type="text" id="agent2" name="agent2" class="form-control" placeholder="Agent Commission">
                                        <span class="text-danger" id="agent2_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent_name2">Agent Name</label>
                                        <select name="agent_name2" class="form-control" id="agent_name2">
                                            <option value="">Select Agent</option>
                                            {% for agent in agents %}
                                            <option value="{{ agent.id }}">{{ agent.name }}</option>
                                            {% endfor %}
                                        </select>
                                        <span class="text-danger" id="agent_name2_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent3">Agent 3 Commission</label>
                                        <input type="text" id="agent3" name="agent3" class="form-control" placeholder="Agent Commission">
                                        <span class="text-danger" id="agent3_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent_name3">Agent Name</label>
                                        <select name="agent_name3" class="form-control" id="agent_name3">
                                            <option value="">Select Agent</option>
                                            {% for agent in agents %}
                                            <option value="{{ agent.id }}">{{ agent.name }}</option>
                                            {% endfor %}
                                        </select>
                                        <span class="text-danger" id="agent_name3_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="agent_comment">Comment by Agent</label>
                                        <textarea class="form-control" name="agent_comment" id="agent_comment" rows="5" placeholder="Agent Comments"></textarea>
                                        <span class="text-danger" id="agent_comment_error"></span>
                                    </div>
                                    {% if perms.property_management_deals.admin_properties_fields_rentalproperties %}
                                        <div class="col-md-6 form-group">
                                            <label for="comments">Comment by Admin</label>
                                            <textarea class="form-control" name="comments" id="comments" rows="5" placeholder="Admin Comments"></textarea>
                                            <span class="text-danger" id="comments_error"></span>
                                        </div>
                                    {% endif %}
                                    <div class="col-md-6 form-group">
                                        <label for="receipt_no">Receipt No<span class="mandetory_field" style="color: red">*</span></label>
                                        <select name="receipt_no" class="form-control" id="receipt_no" required>
                                            <option value="">Select Receipt No</option>
                                            <option value="Null">Null</option>
                                            <option value="No Commision">No Commission</option>
                                            {% for receipt in receipt_nos %}
                                            <option value="{{ receipt.id }}">{{ receipt.receipt_number }}</option>
                                            {% endfor %}
                                        </select>
                                        <span class="text-danger" id="receipt_no_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="kyc_number">KYC Number</label>
                                        <input type="text" id="kyc_number" name="kyc_number" class="form-control" placeholder="KYC Number">
                                        <span class="text-danger" id="kyc_number_error"></span>
                                    </div>

                                    {% if perms.property_management_deals.admin_properties_fields_rentalproperties %}
                                        <div class="col-md-6 form-group">
                                            <label for="is_approved_rejected">Approve/Reject</label>
                                            <div class="row">
                                                <div class="col-4">
                                                    <input type="radio" name="is_approved_rejected" value="A"> Approve
                                                </div>
                                                <div class="col-4">
                                                    <input type="radio" name="is_approved_rejected" value="R"> Reject
                                                </div>
                                                <div class="col-4">
                                                    <input type="radio" name="is_approved_rejected" value="F"> Waiting for Finance
                                                </div>
                                            </div>
                                            <span class="text-danger" id="is_approved_rejected_error"></span>
                                        </div>
                                    {% endif %}

                                    {% if perms.property_management_deals.admin_properties_fields_rentalproperties %}
                                        <div class="col-md-6 form-group">
                                            <label for="is_property_aml">AML<span class="mandetory_field" style="color: red">*</span></label>
                                            <div class="row">
                                                <div class="col-6">
                                                    <input value="Yes" name="is_property_aml" id="is_property_aml_yes" type="radio" required> Yes
                                                </div>
                                                <div class="col-6">
                                                    <input value="No" name="is_property_aml" id="is_property_aml_no" type="radio"> No
                                                </div>
                                            </div>
                                            <span class="text-danger" id="is_property_aml_error"></span>
                                        </div>
                                    {% else %}
                                        <input type="hidden" name="is_property_aml" value="No">
                                    {% endif %}
                                </div>
                                <hr>
                                <div class="form-group row mt-3">
                                    <div class="col-sm-12 d-flex justify-content-center">
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-cheque')">Previous</button>
                                        <button type="button" class="btn btn-primary btn-rounded m-1" onclick="switchTab('nav-documents')">Next</button>
                                        {% if perms.property_management_deals.create_draft_property_rentalproperties %}
                                           <button type="button" class="btn btn-primary btn-rounded m-1" id="saveAsDraftRevenue" onclick="saveAsDraft()">Save As Draft</button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <!-- Upload Documents -->
                            <div class="tab-pane fade" id="nav-documents" role="tabpanel" aria-labelledby="nav-documents-tab">
                                <div class="form-group row nav-documents">
                                    <div class="col-md-6 form-group">
                                        <label for="pms_contract">PMS Contract<span class="mandetory_field" style="color: red">*</span></label>
                                        <input class="imageUploadInput form-control" id="pms_contract" type="file" name="pms_contract" accept=".pdf,.jpg,.jpeg,.png" required>
                                        <div class="file-preview" id="pms_contract_preview"></div>
                                        <span class="text-danger" id="pms_contract_error"></span>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="owner_passport_copy">Owner Passport Copy<span class="mandetory_field" style="color: red">*</span></label>
                                        <input class="imageUploadInput form-control" id="owner_passport_copy" type="file" name="owner_passport_copy" accept=".pdf,.jpg,.jpeg,.png" required>
