<script>
var $main = jQuery.noConflict(true);
window.$main = $main;

console.log("Using $main version:", $main.fn.jquery);
console.log("Validator available:", typeof $main.validator !== "undefined");

function showErrors(validator) {
    let messages = '';
    if (validator && Array.isArray(validator.errorList)) {
        $main.each(validator.errorList, function (_, error) {
            if (!error || !error.element) return;
            const field = $main(error.element);
            const fieldName = field.attr('name');
            let labelText = $main(`label[for="${field.attr('id')}"]`).text().trim();
            if (!labelText) {
                labelText = field.closest('.form-group').find('label').first().text().trim() || fieldName;
            }
            messages += `${labelText.replace(/\*$/, '')}: ${error.message}\n`;
        });
    }
    alert(messages || "Please correct the errors in the form.");
}

function validateChequeDates() {
    const numberOfCheques = parseInt($main('#no_of_cheque').val()) || 0;
    const chequeDatesCount = $main('[name="cheque_date[]"]').length;
    if (numberOfCheques !== chequeDatesCount) {
        $main('#no_of_cheque_error').text(`Please add exactly ${numberOfCheques} cheque date(s).`);
        return false;
    }
    $main('#no_of_cheque_error').text('');
    return true;
}

function switchTab(tabId) {
    const currentTab = document.querySelector('.tab-pane.show.active')?.id;
    const validator = $main("#rental_property_form").validate();

    const tabOrder = [
        'nav-property',
        'nav-source',
        'nav-agency',
        'nav-cheque',
        'nav-revenue',
        'nav-documents'
    ];

    const tabFields = {
        'nav-property': ['submitted_by_agent', 'deal_date', 'reference_number', 'project_name', 'building_name', 'unit_details', 'pms_price', 'pm_start_date', 'pm_end_date', 'tenancy_start_date', 'tenancy_end_date'],
        'nav-source': ['owner_first_name', 'owner_source', 'owner_mobile', 'owner_email', 'seller_nationality'],
        'nav-agency': ['agency_name', 'agent_name', 'agent_phone'],
        'nav-cheque': ['no_of_cheque', 'cheque_date[]'],
        'nav-revenue': ['total_commission', 'less_outside_commission', 'net_commission', 'classic', 'agent1', 'agent_name1', 'receipt_no', 'is_property_aml'],
        'nav-documents': ['pms_contract', 'owner_passport_copy', 'pms_cheque_copy', 'title_deed', 'kyc_form', 'screening']
    };

    // Remove required rules from all fields
    Object.keys(tabFields).forEach(tab => {
        tabFields[tab].forEach(field => {
            $main(`[name="${field}"]`).each(function () {
                $main(this).rules('remove', 'required');
            });
        });
    });

    // Validate current tab if moving forward
    const currentIndex = tabOrder.indexOf(currentTab);
    const targetIndex = tabOrder.indexOf(tabId);
    const isNext = targetIndex > currentIndex;

    if (isNext && currentTab && tabFields[currentTab]) {
        tabFields[currentTab].forEach(field => {
            $main(`[name="${field}"]`).each(function () {
                $main(this).rules('add', { required: true });
            });
        });

        const currentTabValid = $main(`#${currentTab}`).find(':input').valid();
        if (!currentTabValid) {
            showErrors(validator);
            return;
        }

        if (currentTab === 'nav-cheque' && tabId === 'nav-revenue') {
            if (!validateChequeDates()) {
                return;
            }
        }
    }

    $main(`#${tabId}-tab`).tab('show');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function saveAsDraft() {
    const form = $main('#rental_property_form');
    const validator = form.validate();

    const draftFields = [
        'submitted_by_agent', 'deal_date', 'reference_number', 'project_name', 'building_name',
        'unit_details', 'pms_price', 'pm_start_date', 'pm_end_date', 'tenancy_start_date',
        'tenancy_end_date', 'owner_first_name', 'owner_source', 'owner_mobile', 'owner_email',
        'seller_nationality'
    ];

    // Add required rules for draft fields
    draftFields.forEach(field => {
        $main(`[name="${field}"]`).each(function () {
            $main(this).rules('add', { required: true });
        });
    });

    // Remove required rules for other fields
    const allFields = [
        'agency_name', 'agent_name', 'agent_phone', 'brn', 'agent_email', 'no_of_cheque',
        'cheque_date[]', 'total_commission', 'less_outside_commission', 'net_commission',
        'classic', 'agent1', 'agent_name1', 'agent2', 'agent_name2', 'agent3', 'agent_name3',
        'agent_comment', 'comments', 'receipt_no', 'kyc_number', 'is_approved_rejected',
        'is_property_aml', 'pms_contract', 'owner_passport_copy', 'owner_eid_copy',
        'pms_cheque_copy', 'title_deed', 'poa_pp', 'poa_copy', 'key_hand_over_form',
        'kyc_form', 'screening', 'screening_comments'
    ];

    allFields.forEach(field => {
        $main(`[name="${field}"]`).each(function () {
            $main(this).rules('remove', 'required');
        });
    });

    if (form.valid()) {
        const formData = new FormData(form[0]);
        formData.append('save_as', 'draft');

        $main.ajax({
            url: '/rental-properties/create/',
            type: 'POST',
            data: formData,
            headers: {
                'X-CSRFToken': $main('input[name="csrfmiddlewaretoken"]').val()
            },
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.success) {
                    $main('#successmsg').show().find('#alert-primary').text('Draft saved successfully!');
                    setTimeout(() => $main('#successmsg').hide(), 3000);
                } else {
                    alert('Failed to save draft: ' + (response.message || 'Unknown error'));
                }
            },
            error: function (xhr) {
                let errorMsg = xhr.responseJSON?.message || 'Unknown error';
                if (xhr.responseJSON?.message && typeof xhr.responseJSON.message === 'object') {
                    errorMsg = Object.values(xhr.responseJSON.message).join('\n');
                }
                alert('Error saving draft: ' + errorMsg);
            }
        });
    } else {
        showErrors(validator);
    }
}

$main(document).ready(function () {
    // Initialize datepickers
    $main('.startDate, .endDate, .startDates, .endDates, .cheque-dates').datepicker({
        dateFormat: 'yy-mm-dd',
        changeMonth: true,
        changeYear: true
    });

    // Custom validation methods
    $main.validator.addMethod("alphanum_special", function (value, element) {
        return this.optional(element) || /^[\w\s.,\-@()/]+$/.test(value);
    }, "Only letters, numbers, and certain special characters are allowed.");

    $main.validator.addMethod("numeric", function (value, element) {
        return this.optional(element) || /^[0-9]*$/.test(value);
    }, "Please enter a valid number.");

    $main.validator.addMethod("custom_email", function (value, element) {
        return this.optional(element) || /^[a-zA-Z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$/.test(value);
    }, "Please enter a valid email address.");

    $main.validator.addMethod("dateAfterStart", function (value, element, params) {
        const startDate = $main(params).val();
        if (!value || !startDate) return true;
        return new Date(value) >= new Date(startDate);
    }, "End date must be after start date.");

    $main.validator.addMethod("fileSize", function (value, element) {
        const maxFileSize = 3 * 1024 * 1024; // 3MB
        if (element.files && element.files.length > 0) {
            return element.files[0].size <= maxFileSize;
        }
        return true;
    }, "File size must be less than 3MB.");

    $main.validator.addMethod("fileExtension", function (value, element) {
        if (!value) return true;
        const allowedExtensions = ['pdf', 'jpg', 'jpeg', 'png'];
        const extension = value.split('.').pop().toLowerCase();
        return allowedExtensions.includes(extension);
    }, "Only PDF, JPG, JPEG, and PNG files are allowed.");

    // Initialize form validation
    $main('#rental_property_form').validate({
        ignore: "",
        rules: {
            submitted_by_agent: { required: true, alphanum_special: true, maxlength: 255 },
            deal_date: { required: true, date: true },
            reference_number: { required: true, alphanum_special: true, maxlength: 20 },
            project_name: { required: true, alphanum_special: true, maxlength: 255 },
            building_name: { required: true, alphanum_special: true, maxlength: 255 },
            unit_details: { required: true, alphanum_special: true, maxlength: 15 },
            pms_price: { required: true, numeric: true, maxlength: 10 },
            pm_start_date: { required: true, date: true },
            pm_end_date: { required: true, date: true, dateAfterStart: '[name="pm_start_date"]' },
            tenancy_start_date: { required: true, date: true },
            tenancy_end_date: { required: true, date: true, dateAfterStart: '[name="tenancy_start_date"]' },
            owner_first_name: { required: true, alphanum_special: true, maxlength: 255 },
            owner_source: { required: true, alphanum_special: true, maxlength: 255 },
            owner_mobile: { required: true, numeric: true, minlength: 6, maxlength: 15 },
            owner_email: { required: true, custom_email: true, maxlength: 100 },
            seller_nationality: { required: true, alphanum_special: true, maxlength: 255 },
            agency_name: { required: true, alphanum_special: true, maxlength: 255 },
            agent_name: { required: true, alphanum_special: true, maxlength: 255 },
            agent_phone: { required: true, numeric: true, minlength: 6, maxlength: 15 },
            brn: { alphanum_special: true, maxlength: 255 },
            agent_email: { custom_email: true, maxlength: 100 },
            no_of_cheque: { required: true, numeric: true, minlength: 1, maxlength: 2, min: 1, max: 12 },
            'cheque_date[]': { required: true, date: true },
            total_commission: { required: true, numeric: true, maxlength: 10 },
            less_outside_commission: { required: true, numeric: true, maxlength: 10 },
            net_commission: { required: true, numeric: true, maxlength: 10 },
            classic: { required: true, numeric: true, maxlength: 10 },
            agent1: { required: true, numeric: true, maxlength: 10 },
            agent_name1: { required: true, alphanum_special: true, maxlength: 255 },
            agent2: { numeric: true, maxlength: 10 },
            agent_name2: { alphanum_special: true, maxlength: 255 },
            agent3: { numeric: true, maxlength: 10 },
            agent_name3: { alphanum_special: true, maxlength: 255 },
            receipt_no: { required: true, alphanum_special: true, maxlength: 100 },
            kyc_number: { alphanum_special: true, maxlength: 255 },
            agent_comment: { alphanum_special: true, maxlength: 255 },
            comments: { alphanum_special: true, maxlength: 255 },
            is_approved_rejected: { required: false },
            is_property_aml: { required: true },
            pms_contract: { required: true, fileSize: true, fileExtension: true },
            owner_passport_copy: { required: true, fileSize: true, fileExtension: true },
            pms_cheque_copy: { required: true, fileSize: true, fileExtension: true },
            title_deed: { required: true, fileSize: true, fileExtension: true },
            kyc_form: { required: true, fileSize: true, fileExtension: true },
            screening: { required: true, fileSize: true, fileExtension: true },
            owner_eid_copy: { fileSize: true, fileExtension: true },
            poa_pp: { fileSize: true, fileExtension: true },
            poa_copy: { fileSize: true, fileExtension: true },
            key_hand_over_form: { fileSize: true, fileExtension: true },
            screening_comments: { alphanum_special: true, maxlength: 255 }
        },
        errorPlacement: function (error, element) {
            if (element.is(":radio")) {
                error.appendTo(element.closest('.form-group'));
            } else {
                error.insertAfter(element);
            }
        },
        messages: {
            pm_end_date: { dateAfterStart: "PM End Date must be after PM Start Date" },
            tenancy_end_date: { dateAfterStart: "Tenancy End Date must be after Tenancy Start Date" }
        }
    });

    // Handle cheque field addition
    let chequeCount = 1;
    const maxChequeFields = 12;

    $main('#add-cheque-row').on('click', function () {
        const numberOfCheques = parseInt($main('#no_of_cheque').val()) || 0;
        if (chequeCount < maxChequeFields && chequeCount < numberOfCheques) {
            chequeCount++;
            const newField = `
                <div class="row form-group nav-cheque cheque-date-row-${chequeCount}">
                    <div class="col-md-5 form-group">
                        <label for="cheque_date_${chequeCount}">Cheque Date<span class="mandetory_field" style="color: red">*</span></label>
                        <input type="date" id="cheque_date_${chequeCount}" name="cheque_date[]" class="form-control cheque-dates" placeholder="Cheque Date" required>
                        <span class="text-danger" id="cheque_date_${chequeCount}_error"></span>
                    </div>
                    <div class="col-md-7 form-group">
                        <button type="button" class="btn btn-danger btn-rounded m-1 subtraction remove-cheque-btn" data-row="${chequeCount}">Remove</button>
                    </div>
                </div>`;
            $main('.append-cheque-date').append(newField);
            $main(`#cheque_date_${chequeCount}`).rules('add', { required: true, date: true });
            $main(`#cheque_date_${chequeCount}`).datepicker({
                dateFormat: 'yy-mm-dd',
                changeMonth: true,
                changeYear: true
            });
        } else if (chequeCount >= numberOfCheques) {
            alert('Cannot add more cheque dates than specified in Number of Cheques.');
        } else {
            alert('Maximum 12 cheque dates allowed.');
        }
    });

    // Handle cheque field removal
    $main(document).on('click', '.remove-cheque-btn', function () {
        const row = $main(this).data('row');
        $main(`.cheque-date-row-${row}`).remove();
        chequeCount--;
        validateChequeDates();
    });

    // Update cheque count validation on input change
    $main('#no_of_cheque').on('input', function () {
        validateChequeDates();
    });

    // File input preview and validation
    $main('input[type="file"]').on('change', function () {
        const fieldName = $main(this).attr('name');
        const previewElement = $main(`#${fieldName}_preview`);
        const errorElement = $main(`#${fieldName}_error`);
        const files = this.files;

        previewElement.empty();
        errorElement.text('');

        if (files.length > 1) {
            errorElement.text('Please select only one file.');
            $main(this).val('');
            return;
        }

        if (files.length === 1) {
            const file = files[0];
            const maxFileSize = 3 * 1024 * 1024; // 3MB
            const allowedExtensions = ['pdf', 'jpg', 'jpeg', 'png'];
            const extension = file.name.split('.').pop().toLowerCase();

            if (!allowedExtensions.includes(extension)) {
                errorElement.text('Only PDF, JPG, JPEG, and PNG files are allowed.');
                $main(this).val('');
                return;
            }

            if (file.size > maxFileSize) {
                errorElement.text('File size must be less than 3MB.');
                $main(this).val('');
                return;
            }

            previewElement.text(`Selected: ${file.name} (${(file.size / 1024).toFixed(2)} KB)`);
        }
    });

    // Form submission via AJAX
    $main('#rental_property_form').on('submit', function (e) {
        e.preventDefault();
        const form = $main(this);
        const validator = form.validate();

        // Validate cheque dates for full submission
        if (!validateChequeDates()) {
            return false;
        }

        const allRequiredFields = [
            'submitted_by_agent', 'deal_date', 'reference_number', 'project_name', 'building_name',
            'unit_details', 'pms_price', 'pm_start_date', 'pm_end_date', 'tenancy_start_date',
            'tenancy_end_date', 'owner_first_name', 'owner_source', 'owner_mobile', 'owner_email',
            'seller_nationality', 'agency_name', 'agent_name', 'agent_phone', 'no_of_cheque',
            'cheque_date[]', 'total_commission', 'less_outside_commission', 'net_commission',
            'classic', 'agent1', 'agent_name1', 'receipt_no', 'is_property_aml',
            'pms_contract', 'owner_passport_copy', 'pms_cheque_copy', 'title_deed', 'kyc_form', 'screening'
        ];

        allRequiredFields.forEach(field => {
            $main(`[name="${field}"]`).each(function () {
                $main(this).rules('add', { required: true });
            });
        });

        if (!form.valid()) {
            showErrors(validator);
            return;
        }

        const formData = new FormData(form[0]);

        $main.ajax({
            url: '/rental-properties/create/',
            type: 'POST',
            data: formData,
            headers: {
                'X-CSRFToken': $main('input[name="csrfmiddlewaretoken"]').val()
            },
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.success) {
                    $main('#successmsg').show().find('#alert-primary').text('Property created successfully!');
                    setTimeout(() => {
                        $main('#successmsg').hide();
                        window.location.href = '/rental-properties/list/';
                    }, 3000);
                } else {
                    let errorMsg = response.message || 'Unknown error';
                    if (response.message && typeof response.message === 'object') {
                        errorMsg = Object.values(response.message).join('\n');
                    }
                    alert('Failed to create property: ' + errorMsg);
                }
            },
            error: function (xhr) {
                let errorMsg = xhr.responseJSON?.message || 'Unknown error';
                if (xhr.responseJSON?.message && typeof xhr.responseJSON.message === 'object') {
                    errorMsg = Object.values(xhr.responseJSON.message).join('\n');
                }
                alert('Error creating property: ' + errorMsg);
            }
        });
    });
});
